# Terraform
#
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions
# and their hashes, and belongs in version control so every run — local or on
# Terraform Cloud — resolves the same providers.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
infra/expired_token.txt

