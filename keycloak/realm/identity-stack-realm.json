  "clients": [
    {
      "clientId": "identity-stack-spa",
      "name": "The identity-stack SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:3000"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/login"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "web-origins",
        "acr"
      ],
      "optionalClientScopes": [
        "organization",
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "identity-stack-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "identity-stack-api",
      "name": "The identity-stack API: its id is the access token audience; its client roles are the canonical permissions and roles",
      "enabled": true,
      "publicClient": false,
      "secret": "local-only-api-client",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    },
    {
      "clientId": "identity-stack-other",
      "name": "Another public client, without the API audience",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:3000"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/login"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "web-origins",
        "acr"
      ],
      "optionalClientScopes": [
        "organization",
        "offline_access"
      ]
    },
    {
      "clientId": "identity-stack-admin",
      "name": "Backend service account: pushes to and pulls from the realm",
      "enabled": true,
      "publicClient": false,
      "secret": "local-only-admin-client",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "kc-admin-api"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "admin-permissions",
      "authorizationServicesEnabled": true,
      "authorizationSettings": {
        "resources": [
          {
            "name": "Clients",
            "type": "Clients",
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "manage"
              },
              {
                "name": "map-roles"
              },
              {
                "name": "map-roles-client-scope"
              },
              {
                "name": "map-roles-composite"
              }
            ]
          }
        ],
        "policies": [
          {
            "name": "identity-stack-admin service account",
            "type": "user",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "users": "[\"service-account-identity-stack-admin\"]"
            }
          },
          {
            "name": "identity-stack-admin manages the API client",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "defaultResourceType": "Clients",
              "resources": "[\"identity-stack-api\"]",
              "scopes": "[\"view\", \"manage\", \"map-roles-composite\"]",
              "applyPolicies": "[\"identity-stack-admin service account\"]"
            }
          },
          {
            "name": "identity-stack-admin reads the realm-management client",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "defaultResourceType": "Clients",
              "resources": "[\"realm-management\"]",
              "scopes": "[\"view\"]",
              "applyPolicies": "[\"identity-stack-admin service account\"]"
            }
          }
        ],
        "scopes": [
          {
            "name": "view"
          },
          {
            "name": "manage"
          },
          {
            "name": "map-roles"
          },
          {
            "name": "map-roles-client-scope"
          },
          {
            "name": "map-roles-composite"
          }
        ]
      }
    }
  ],
